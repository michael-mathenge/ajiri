# Copy this file to `.env` (same folder as manage.py) and fill in real values.
# `.env` is git-ignored: never commit it. This example file IS committed, so it
# must never contain a real secret.
# Explained in docs/CONCEPTS.md#environment-variables

# ---- Local development: set DEBUG=True and you can leave the rest empty ----
DEBUG=True

# ---- Production (PythonAnywhere): DEBUG=False and everything below filled in ----
# Generate a SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=
# Local development only; production uses its exact reviewed public HTTPS origin.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret for POST /api/jobs/ingest/ and /api/jobs/sweep/. Must equal the
# INGEST_API_KEY secret stored in GitHub. Generate it the same way as above.
INGEST_API_KEY=

# Only set to True if the host's proxy sets X-Forwarded-Proto (see the runbook).
TRUST_PROXY_SSL_HEADER=False

# Local mail sink only. Security-link test capture and real provider sending are separate.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
REAL_EMAIL_ENABLED=False
# Separate owner-only synthetic application pilot; never enable for real employers.
APPLICATION_EMAIL_ENABLED=False
# Prepare/review only; keep sending False until personal document/send approval exists.
APPLICATION_PILOT_PREPARATION_ENABLED=False
APPLICATION_PILOT_LIMIT_REVIEW=
ACCOUNT_EMAIL_TEST_CAPTURE=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ajiri <noreply@example.invalid>

# Absolute directory outside all public/static mappings; relocate existing files first.
# PRIVATE_MEDIA_ROOT=C:/dev/ajiri-private-media
# Optional private directory outside code, database and media trees.
# Defaults to ~/ajiri-erasure-ledger; back it up and replay completed requests before old restores.
# ERASURE_LEDGER_DIR=/home/your-account/ajiri-erasure-ledger
# Optional owner-only synthetic alert pilot; normal ingestion cannot send email.
ALERT_EMAIL_ENABLED=False
PUBLIC_JOBS_ENABLED=False
PUBLIC_JOB_ORIGIN=
# Run migrations before starting requests with the publication gate enabled.
JOB_FRESHNESS_ENFORCED=True
EMPLOYER_POSTING_ENABLED=False

# Saved-search feature (apply jobs.0014 before activation)
SAVED_SEARCHES_ENABLED=False
